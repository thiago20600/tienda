# Base de datos
DB_URL=postgresql+psycopg://tu_usuario:tu_password@db_facturacion:5432/tu_base_de_datos
POSTGRES_USER=tu_usuario
POSTGRES_DB=tu_base_de_datos
POSTGRES_PASSWORD=tu_password

# Autenticación JWT (las MISMAS credenciales que backend y usuarios)
SECRET_KEY_JWT=tu_clave_secreta_jwt_aqui
ALGORITHM=HS256

# Servicio de usuarios (sync de permisos) y autenticación service-to-service
API_USUARIOS_URL=http://api_usuarios:80
TOKEN_SERVICIO_INTERNO_API=tu_token_interno

# ARCA (ex AFIP)
AFIP_CUIT=20123456789
# Rutas al certificado y a la clave privada (ver facturacion/certs/README.MD).
# El servicio lee el CONTENIDO de estos archivos: colocalos dentro de facturacion/certs/
AFIP_CERT_PATH=certs/certificado.crt
AFIP_KEY_PATH=certs/clave.key
AFIP_PUNTO_VENTA=1
# homologacion (pruebas) | produccion
AFIP_AMBIENTE=homologacion
# Token de app.afipsdk.com (el SDK 1.2.0 usa ese proxy para el TA y las llamadas SOAP)
AFIP_ACCESS_TOKEN=

# Parámetros de emisión
AFIP_TIPO_COMPROBANTE_DEFAULT=6
AFIP_DOC_TIPO_DEFAULT=99
AFIP_RAZON_SOCIAL_DEFAULT=Consumidor Final
AFIP_ALICUOTA_IVA=21.00

# Datos del emisor que se imprimen en el PDF del comprobante
AFIP_RAZON_SOCIAL_EMISOR=Mi Empresa S.A.
AFIP_DOMICILIO_EMISOR=Av. Siempre Viva 742, CABA
AFIP_INGRESOS_BRUTOS=123456789
AFIP_INICIO_ACTIVIDADES=01/01/2020
# Base del QR de la RG 4290 (no cambiar salvo que ARCA publique otra)
AFIP_QR_URL_BASE=https://www.afip.gob.ar/fe/qr/

# Reintentos de emisión
FACTURACION_MAX_INTENTOS=10
FACTURACION_BACKOFF_BASE_SEGUNDOS=60
# Jitter anti retry-storm: segundos aleatorios extra sumados al backoff
FACTURACION_JITTER_SEGUNDOS=30
# Lote máximo por barrida de reintentos (acota la concurrencia hacia ARCA)
FACTURACION_LOTE_TAMANIO=5
# Segundos: un claim en `procesando` más viejo que esto se considera huérfano
FACTURACION_TIMEOUT_PROCESANDO_SEGUNDOS=300

# CORS
CORS_ORIGINS=http://localhost:5173

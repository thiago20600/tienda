FROM python:3.11-slim

WORKDIR /code

COPY ./requirements.txt /code/requirements.txt

RUN pip install --no-cache-dir --upgrade -r /code/requirements.txt

COPY . /code

EXPOSE 80

# Migra el esquema antes de levantar el servicio (mismo criterio que api_tienda)
CMD ["sh", "-c", "alembic upgrade head && fastapi dev main.py --host 0.0.0.0 --port 80"]
